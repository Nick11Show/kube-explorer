#!/bin/bash
#
# Download UI assets used when building with the "embed" build tag.
#
# The dashboard assets are sourced from the official Rancher dashboard release,
# using the "*-embedded" build which is designed for embedding (it serves its
# assets under /dashboard/ and references /favicon.png, matching the
# kube-explorer embedded UI router).
#
# The original Pandaria dashboard source
# (pandaria-dashboard-ui.s3.ap-southeast-2.amazonaws.com) is no longer
# reachable and has been removed.
#
# Override the versions via environment variables:
#   CATTLE_DASHBOARD_UI_VERSION  (default v2.12.0 for the Rancher v2.12.x stack)
#   CATTLE_API_UI_VERSION        (default 1.1.11)

source "$(dirname "$0")/version"

: "${CATTLE_DASHBOARD_UI_VERSION:=v2.12.0}"
: "${CATTLE_API_UI_VERSION:=1.1.11}"

cd "$(dirname "$0")/.." || exit 1;

TAR_CMD="tar"

rm -rf internal/ui/ui/dashboard internal/ui/ui/api-ui
mkdir -p internal/ui/ui/dashboard internal/ui/ui/api-ui

# Dashboard (embedded build)
echo "Downloading Rancher dashboard ${CATTLE_DASHBOARD_UI_VERSION} (embedded)..."
TMP="$(mktemp -d)"
curl -sL "https://releases.rancher.com/dashboard/${CATTLE_DASHBOARD_UI_VERSION}.tar.gz" -o "$TMP/dashboard.tar.gz"
tar xzf "$TMP/dashboard.tar.gz" -C internal/ui/ui/dashboard --strip-components=2 "dist/${CATTLE_DASHBOARD_UI_VERSION}-embedded"
# Keep a copy at ui/index.html for the non-embed (filepath) handler parity.
cp internal/ui/ui/dashboard/index.html internal/ui/ui/index.html 2>/dev/null || true
rm -rf "$TMP"

# API UI
echo "Downloading Rancher api-ui ${CATTLE_API_UI_VERSION}..."
curl -sL "https://releases.rancher.com/api-ui/${CATTLE_API_UI_VERSION}.tar.gz" | $TAR_CMD xzf - -C internal/ui/ui/api-ui --strip-components=1
